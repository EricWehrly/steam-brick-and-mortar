# Copy this file to .env.tauri and adjust as needed.
# Loaded by Vite when building with `--mode tauri` for the desktop shell (desktop/tauri-app).
# Kept separate from .env so this value can be dropped from the desktop build in one place,
# without touching the web client's env. Still Lambda-backed for now — see
# docs/plans/rust-cors-bypass-spike.md, which will let the desktop app talk to Steam directly
# and remove the need for this entirely.
#
# TODO: this is currently a manually-copied literal. It could instead be sourced from the
# `full_domain_name` terraform output (external-tool/infrastructure/outputs.tf) if this project
# ever grows a more automated deploy story - not something we expect to need, but worth knowing
# if someone else stands up their own copy of the Lambda.

VITE_STEAM_API_BASE_URL=https://your-steam-api-host.example.com
