{
  "name": "steam-brick-and-mortar-client",
  "version": "0.1.0",
  "description": "WebXR VR game launcher with Steam integration",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "tsc && yarn build:bookmarklets && vite build",
    "build:bookmarklets": "node scripts/build-bookmarklets.mjs",
    "release": "bash ../scripts/release.sh",
    "preview": "vite preview",
    "test": "vitest run --config test/vitest.config.ts",
    "test:watch": "vitest --reporter=verbose --config test/vitest.config.ts",
    "test:ui": "vitest --ui --config test/vitest.config.ts",
    "test:performance": "vitest run --config test/vitest.performance.config.ts",
    "test:integration": "vitest run --config test/vitest.integration.config.ts",
    "test:live": "vitest run test/live --config test/vitest.live.config.ts",
    "test:all": "vitest run --config test/vitest.all.config.ts",
    "test:visual": "playwright test --config playwright.config.ts",
    "test:visual:docker": "docker compose -f ../docker-compose.yml run --rm playwright",
    "clean": "rm -rf dist node_modules .vite",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "validate": "yarn type-check && yarn test && yarn lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.7.2",
    "@types/three": "^0.183.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/ui": "^4.1.2",
    "@webxr-input-profiles/motion-controllers": "^1.0.0",
    "canvas": "^3.1.2",
    "eslint": "^10.1.0",
    "jsdom": "^29.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "cockatiel": "^4.0.0",
    "n8ao": "^1.10.2",
    "postprocessing": "^6.39.1",
    "three": "^0.183.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
