{
  "name": "steam-brick-and-mortar-client",
  "version": "0.1.0",
  "description": "WebXR VR game launcher with Steam integration",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite --open",
    "start": "vite --open",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:summary": "vitest run && node scripts/test-summary.cjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:live": "vitest run test/live --config vitest.all.config.ts",
    "test:all": "vitest run --config vitest.all.config.ts",
    "clean": "rm -rf dist node_modules .vite",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test:visual": "playwright test --config playwright.config.ts",
    "test:visual:docker": "docker compose -f ../docker-compose.yml run --rm playwright"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.7.2",
    "@types/three": "^0.183.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/ui": "^4.1.2",
    "@webxr-input-profiles/motion-controllers": "^1.0.0",
    "canvas": "^3.1.2",
    "eslint": "^10.1.0",
    "jsdom": "^29.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "three": "^0.183.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
