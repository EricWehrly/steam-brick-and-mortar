dist

# reference materials
reference/

# Extracted intermediary files, converted assets, and pipeline logs — personal-mode only, never commit
desktop/source-extract/extracted/
desktop/source-extract/output/
desktop/source-extract/logs/
desktop/source-extract/tools/vpkedit/
client/public/test-props/
# Generated by scripts/repack-steam-cache.sh (release.sh Step 2) - the two client-served
# app-details bundles. Regenerated from S3 on every release run; not source, never commit.
client/public/steam-cache/
# Raw per-appid S3 cache dump staged by release.sh Step 1, outside client/public/ so it's
# never accidentally served. Consumed and can be deleted after Step 2 repacks it.
.release-cache/
# Generated by scripts/bake-f2p-artwork.sh (release.sh Step 2.5) - baked F2P/anonymous-store
# artwork + manifest.json. Regenerated on every release run; not source, never commit.
client/public/artwork-cache/

# Python bytecode (SourceIO addon in blender/addons/)
**/__pycache__/
*.py[cod]

# SourceIO Blender addon — committed as zip, extracted directory is gitignored
blender/addons/SourceIO/
!blender/addons/SourceIO.zip
